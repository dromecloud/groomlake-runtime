{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groomlake.drome.cloud/schemas/install-plan.schema.json",
  "title": "Groomlake installation plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "profile", "runtime"],
  "properties": {
    "schema_version": { "const": 2 },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_version", "manifest_sha256", "commit"],
      "properties": {
        "manifest_version": {
          "type": "string",
          "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$"
        },
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    }
  }
}
