{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groomlake.drome.cloud/schemas/runtime-manifest.schema.json",
  "title": "Groomlake runtime manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_version", "runtime", "profiles", "provisioning", "components"],
  "properties": {
    "schema_version": { "const": 2 },
    "manifest_version": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "repository", "entrypoint"],
      "properties": {
        "id": { "const": "groomlake-runtime" },
        "name": { "const": "Mission Systems Runtime" },
        "description": { "type": "string", "minLength": 1 },
        "repository": { "const": "dromecloud/groomlake-runtime" },
        "entrypoint": { "const": "bin/msr" }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/profileCatalogEntry" }
    },
    "provisioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profiles"],
      "properties": {
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "additionalProperties": { "$ref": "#/$defs/provisioningProfile" }
        }
      }
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/componentCatalogEntry" }
    }
  },
  "$defs": {
    "displayBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "description", "order"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 }
      }
    },
    "profileCatalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "display", "compatibility"],
      "properties": {
        "manifest": { "type": "string", "minLength": 1 },
        "display": { "$ref": "#/$defs/displayBase" },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["architectures", "images"],
          "properties": {
            "architectures": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["x86", "arm"] }
            },
            "images": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" }
            }
          }
        }
      }
    },
    "componentCatalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "display"],
      "properties": {
        "manifest": { "type": "string", "minLength": 1 },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "description", "category", "order"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "category": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "order": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "provisioningProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "label", "architectures", "release_channels"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "architectures": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["x86", "arm"] } },
        "release_channels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/releaseChannel" }
        }
      }
    },
    "releaseChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "available", "note", "bootstrap"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "available": { "type": "boolean" },
        "note": { "type": "string" },
        "bootstrap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "url", "sha256", "filename", "runtime_commit"],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "pattern": "^https://" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "filename": { "type": "string", "minLength": 1 },
            "runtime_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        }
      }
    }
  }
}
