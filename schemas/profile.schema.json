{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groomlake.drome.cloud/schemas/profile.schema.json",
  "title": "Groomlake profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "label", "components", "sequences"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "config"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "config": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sequences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
