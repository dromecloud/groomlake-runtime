              "sha256": "6eeeb9e85f12f63496837d3e2dbd1203856da665671fb4b4f5426ea271992c25",
              "filename": "mso-bootstrap-v1.0.0.sh"
            }
          },
          "dev": {
            "label": "Development",
            "available": true,
            "note": "Nur fuer den kontrollierten Frischserver-Test.",
            "bootstrap": {
              "version": "v1.0.0",
              "url": "https://codehangar.aero.drome.cloud/server/bootstrap/ubuntu/24.04/dev/base/mso-bootstrap-v1.0.0.sh",
              "sha256": "6eeeb9e85f12f63496837d3e2dbd1203856da665671fb4b4f5426ea271992c25",
              "filename": "mso-bootstrap-v1.0.0.sh"
